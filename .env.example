COMPOSE_PROJECT_NAME=sanitas
# Published official release; do not replace with stable/latest/main/develop.
HELPDESK_IMAGE=ghcr.io/frappe/helpdesk:v1.31.0
FRAPPE_PLATFORM=linux/amd64
SITE_NAME=helpdesk.localhost
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
PUBLIC_URL=http://helpdesk.localhost:8080
# Used only with deploy/compose.https.yaml
PUBLIC_HOST=helpdesk.example.org
ACME_EMAIL=admin@example.org
